<?xml version="1.0" encoding="utf-8"?>
<!-- 启动窗口背景（深色）：night 限定符优先级高于版本限定符，
     所以深色系统下这份会盖掉 drawable/launch_background.xml。 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/brand_canvas" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/brand_splash_dark" />
    </item>
</layer-list>
