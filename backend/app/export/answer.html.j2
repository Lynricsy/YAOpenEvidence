{#
  打印用单页 HTML：只有亮色，色值是 Web OKLCH 令牌的 sRGB 版（与 flutter tokens.dart 一致）。
  页边距、页眉页脚由 Chromium 的 page.pdf() 参数提供，这里不写 @page。
#}
<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<title>{{ question }}</title>
<style>
:root {
  --fg: #261D16; --muted: #6B6157; --border: #E1DDD7; --muted-bg: #F3F0EA;
  --primary: #1F7583; --primary-bg: #EEF6F6; --warning: #945A00; --success: #0B7643;
  --mark-bg: #FCE6A6; --mark-fg: #3A2A1B;
  --q1: #0B7643; --q2: #006D95; --q3: #945A00; --q4: #72665E;
  --serif: "Noto Serif CJK SC", "Noto Serif SC", "Songti SC", serif;
  --sans: "Inter", "Noto Sans CJK SC", "PingFang SC", system-ui, sans-serif;
  --mono: "SF Mono", Menlo, Consolas, "Noto Sans Mono CJK SC", monospace;
}
* { box-sizing: border-box; }
body {
  margin: 0; font: 10.5pt/1.8 var(--serif); color: var(--fg);
  -webkit-print-color-adjust: exact; print-color-adjust: exact;
}
h1.question {
  margin: 0; font: 600 20pt/1.35 var(--serif); letter-spacing: -0.01em; word-break: break-word;
}
.metaline {
  display: flex; flex-wrap: wrap; align-items: center; gap: 6pt;
  margin-top: 7pt; font: 400 8.5pt/1.4 var(--sans); color: var(--muted);
}
.followup { margin: 6pt 0 0; font: 400 8.5pt/1.5 var(--sans); color: var(--muted); }
.pill {
  --tone: var(--muted);
  display: inline-block; font: 500 8pt/1.5 var(--sans); padding: 1px 7px; border-radius: 999px;
  color: var(--tone); background: color-mix(in srgb, var(--tone) 12%, white);
}
.pill[data-tone="primary"] { --tone: var(--primary); }
.pill[data-tone="warning"] { --tone: var(--warning); }
.pill[data-tone="success"] { --tone: var(--success); }
.pill[data-tone="q1"] { --tone: var(--q1); }
.pill[data-tone="q2"] { --tone: var(--q2); }
.pill[data-tone="q3"] { --tone: var(--q3); }
.pill[data-tone="q4"] { --tone: var(--q4); }

.module {
  display: flex; align-items: baseline; gap: 7pt;
  margin-top: 18pt; padding-bottom: 4pt; border-bottom: 1px solid var(--border);
  break-after: avoid;
}
.module h2 { margin: 0; font: 600 13.5pt/1.3 var(--serif); color: var(--tone, var(--fg)); }
.module .eyebrow { font: 500 7.5pt/1 var(--sans); letter-spacing: .08em; color: var(--muted); }
.module .count { margin-left: auto; font: 400 8.5pt/1 var(--sans); color: var(--muted); }
.module[data-tone="primary"] { --tone: var(--primary); }
.module[data-tone="warning"] { --tone: var(--warning); }

.conclusion {
  margin-top: 18pt; padding: 12pt 14pt; border: 1px solid rgba(31, 117, 131, .2);
  border-radius: 8pt; background: var(--primary-bg); break-inside: avoid;
}
.conclusion .module { margin-top: 0; padding-bottom: 2pt; border-bottom: 0; }
.conclusion .prose { font-size: 11pt; line-height: 1.85; }

.prose { margin-top: 8pt; }
.prose p { margin: 0 0 7pt; orphans: 3; widows: 3; }
.prose ul, .prose ol { margin: 0 0 7pt; padding-left: 1.4em; }
.prose li { margin: 2pt 0; }
.prose.evidence li::marker { color: var(--primary); }
.prose.caveats li::marker { color: var(--warning); }
.prose h1, .prose h2, .prose h3, .prose h4 { break-after: avoid; }
.prose h2 { margin: 12pt 0 6pt; font: 600 12.5pt/1.4 var(--serif); }
.prose h1, .prose h3, .prose h4 { margin: 12pt 0 6pt; font: 600 11pt/1.4 var(--serif); }
.prose blockquote {
  margin: 0 0 7pt; padding-left: 10pt; color: var(--muted);
  border-left: 2px solid rgba(31, 117, 131, .4);
}
.prose code {
  font: 400 9pt/1.5 var(--mono); background: var(--muted-bg); border-radius: 3pt; padding: 0 3px;
}
.prose pre { background: var(--muted-bg); border-radius: 6pt; padding: 8pt; overflow-wrap: anywhere; }
.prose pre code { background: none; padding: 0; }
.prose a { color: var(--primary); }
.prose hr { border: 0; border-top: 1px solid var(--border); margin: 10pt 0; }

.prose table {
  width: 100%; border-collapse: collapse; font: 400 8.5pt/1.55 var(--sans); margin: 0 0 8pt;
}
.prose thead { display: table-header-group; }
.prose tr { break-inside: avoid; }
.prose th, .prose td { padding: 4pt 6pt; border-bottom: 1px solid var(--border); vertical-align: top; }
.prose th { background: var(--muted-bg); font-weight: 600; text-align: left; }
.prose td:first-child, .prose th:first-child { font-weight: 600; }

.cite {
  display: inline-block; font: 600 7.5pt/1 var(--mono); padding: 1.5pt 4pt; border-radius: 3pt;
  color: var(--c); background: color-mix(in srgb, var(--c) 10%, white);
  border: 1px solid color-mix(in srgb, var(--c) 28%, white);
  vertical-align: .15em; margin: 0 1px; text-decoration: none;
}
.cite span { opacity: .75; margin-left: 1px; }

.ref {
  display: grid; grid-template-columns: 20pt 1fr; gap: 8pt; padding: 7pt 0;
  border-bottom: 1px solid var(--border); break-inside: avoid;
}
.ref .n {
  display: grid; place-items: center; width: 18pt; height: 18pt; border-radius: 4pt;
  font: 600 8.5pt/1 var(--mono); color: #fff;
}
.ref .title { font: 500 10.5pt/1.5 var(--serif); word-break: break-word; }
.ref .meta { margin-top: 2pt; font: 400 8.5pt/1.5 var(--sans); color: var(--muted); }
.ref .badges { display: flex; flex-wrap: wrap; align-items: center; gap: 5pt; margin-top: 4pt; }
.ref .badges .cited { font: 400 8pt/1.5 var(--sans); color: var(--muted); }
.ref .ids { margin-top: 3pt; font: 400 8pt/1.5 var(--sans); color: var(--muted); }
.ref .ids a { color: var(--primary); text-decoration: none; margin-right: 8pt; }
.ref .ids span { margin-right: 8pt; }

.paper-head { margin-top: 10pt; font: 600 9pt/1.5 var(--sans); break-after: avoid; }
.passage {
  display: grid; grid-template-columns: 44pt 1fr; gap: 6pt; padding: 6pt 0;
  border-bottom: 1px dotted var(--border); break-inside: avoid;
}
.passage .loc { font: 400 8pt/1.5 var(--sans); color: var(--muted); }
.passage .text { font: 400 9.5pt/1.7 var(--serif); }
.passage mark { background: var(--mark-bg); color: var(--mark-fg); padding: 0 1px; }

.kb { padding: 6pt 0; border-bottom: 1px solid var(--border); break-inside: avoid; }
.kb .head { display: flex; align-items: center; gap: 6pt; font: 400 8.5pt/1.5 var(--sans); color: var(--muted); }
.kb .text { margin: 3pt 0 0; font-size: 9.5pt; }
.kb .zh { margin: 2pt 0 0; font-size: 9.5pt; color: var(--muted); }
.kb .src { margin: 3pt 0 0; font: 400 8pt/1.5 var(--sans); color: var(--muted); }

pre.queries {
  margin: 8pt 0 0; font: 400 8pt/1.7 var(--mono); background: var(--muted-bg);
  border-radius: 6pt; padding: 8pt; white-space: pre-wrap; word-break: break-all;
}
.answer-id { margin-top: 16pt; font: 400 7.5pt/1.5 var(--mono); color: var(--muted); }
</style>
</head>
<body>

{% macro module(key, count='') %}
{% set m = modules[key] %}
<div class="module" data-tone="{{ m[2] }}">
  <h2>{{ m[0] }}</h2>
  <span class="eyebrow">{{ m[1] }}</span>
  {% if count %}<span class="count">{{ count }}</span>{% endif %}
</div>
{% endmacro %}

<h1 class="question">{{ question }}</h1>
<div class="metaline">
  {% if is_codex %}<span class="pill" data-tone="primary">智能体</span>{% endif %}
  {% for item in meta %}<span>{{ item }}</span>{% endfor %}
  {% if filters_label %}<span class="pill">{{ filters_label }}</span>{% endif %}
</div>
{% if root_question %}
<p class="followup">追问 · 首轮问题：{{ root_question }}</p>
{% endif %}

{% for s in sections %}
  {% if s.kind == 'conclusion' %}
<section class="conclusion">
  {{ module(s.kind) }}
  <div class="prose">{{ s.html }}</div>
</section>
  {% else %}
<section>
  {% if s.title %}{{ module(s.kind) }}{% endif %}
  <div class="prose {{ s.kind }}">{{ s.html }}</div>
</section>
  {% endif %}
{% endfor %}

{% if references %}
<section>
  {{ module('sources', '%d 篇 · %d 篇全文'|format(n_papers, n_fulltext)) }}
  {% for r in references %}
  <div class="ref" id="ref-{{ r.n }}">
    <span class="n" style="background:{{ r.color }}">{{ r.n }}</span>
    <div>
      <div class="title">{{ r.title }}</div>
      <div class="meta">
        {%- for m in r.meta %}{% if not loop.first %} · {% endif %}
        {%- if m.italic %}<i>{{ m.text }}</i>{% else %}{{ m.text }}{% endif %}
        {%- endfor %}
      </div>
      <div class="badges">
        {% for b in r.badges %}<span class="pill" data-tone="{{ b.tone }}">{{ b.text }}</span>{% endfor %}
        <span class="cited">正文引用 {{ r.cited }} 处</span>
      </div>
      {% if r.ids %}
      <div class="ids">
        {% for i in r.ids %}
        {% if i.href %}<a href="{{ i.href }}">{{ i.text }}</a>{% else %}<span>{{ i.text }}</span>{% endif %}
        {% endfor %}
      </div>
      {% endif %}
    </div>
  </div>
  {% endfor %}
</section>
{% endif %}

{% if passage_groups %}
<section>
  {{ module('passages', '%d 条'|format(n_citations)) }}
  {% for g in passage_groups %}
  <div class="paper-head">{{ g.head }}</div>
  {% for p in g['items'] %}
  <div class="passage" id="c-{{ g.n }}-{{ p.pid }}">
    <div>
      <span class="cite" style="--c:{{ g.color }}">{{ g.n }}<span>¶{{ p.pid }}</span></span>
    </div>
    <div>
      <div class="loc">
        {{ p.loc }}
        {% if p.key_finding %}<span class="pill">关键发现</span>{% endif %}
      </div>
      <div class="text">{{ p.text }}</div>
    </div>
  </div>
  {% endfor %}
  {% endfor %}
</section>
{% endif %}

{% if kb_hits %}
<section>
  {{ module('kb', '%d 条'|format(kb_hits|length)) }}
  {% for hit in kb_hits %}
  <article class="kb">
    <div class="head">
      <span class="pill">{{ '事实' if hit.kind == 'fact' else '段落' }}</span>
      <span>相似度 {{ '%.2f'|format(hit.score) }}</span>
    </div>
    <p class="text">{{ hit.text }}</p>
    {% if hit.text_zh %}<p class="zh">{{ hit.text_zh }}</p>{% endif %}
    <p class="src">{{ hit.title }} · {{ hit.journal }} ({{ hit.year }})</p>
  </article>
  {% endfor %}
</section>
{% endif %}

{% if queries %}
<section>
  {{ module('queries', '%d 条'|format(queries|length)) }}
  <pre class="queries">{% for q in queries %}{{ q }}{% if not loop.last %}
{% endif %}{% endfor %}</pre>
</section>
{% endif %}

<p class="answer-id">{{ answer_id }}</p>
</body>
</html>
