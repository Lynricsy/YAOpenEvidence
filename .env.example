# 宿主机映射的 API 端口（本机 8000 已被占用，默认 8765）
YAOE_PORT=8765

# 用户登录会话固定有效期（秒）；首次管理员通过 yaoe create-admin 创建
YAOE_SESSION_TTL_S=604800
YAOE_LOGIN_MAX_ATTEMPTS=10
YAOE_LOGIN_WINDOW_S=300
YAOE_MAX_ACTIVE_JOBS_PER_USER=2

# LLM 网关（compose 里默认指向宿主机 LiteLLM :4000）
LLM_BASE=http://host.docker.internal:4000/v1
LLM_MODEL=qwen3-14b
LOCAL_QWEN_KEY=sk-123456

# 可选：上游文献 API 配额
NCBI_API_KEY=
S2_API_KEY=

# 前端（nginx）宿主机端口
YAOE_WEB_PORT=39109
